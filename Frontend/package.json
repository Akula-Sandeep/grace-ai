{
  "name": "ai-movie-agent",
  "private": true,
  "version": "5.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src e2e scripts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "api:types": "python ../Backend/scripts/export_openapi.py && openapi-typescript ../Backend/openapi.json -o src/generated/api-schema.ts",
    "typecheck:api": "npm run api:types && tsc --noEmit --skipLibCheck --strict src/generated/api-schema.ts",
    "i18n:coverage": "node scripts/i18n-coverage.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@sentry/react": "^11.2.0",
    "@tanstack/react-query": "^5.104.0",
    "@vitejs/plugin-react": "5.0.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "vite": "7.3.6",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
