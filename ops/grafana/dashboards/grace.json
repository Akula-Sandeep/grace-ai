      "id": 1,
      "targets": [{ "expr": "1 - sum(rate(grace_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(grace_http_requests_total[5m])), 1e-9)", "legendFormat": "availability" }],
      "title": "Availability (5m)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(grace_time_to_first_token_seconds_bucket[5m])))", "legendFormat": "p95 TTFT" }],
      "title": "Time to first token p95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
