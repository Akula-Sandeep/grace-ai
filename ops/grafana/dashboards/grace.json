      "id": 3,
      "targets": [{ "expr": "sum(rate(grace_chat_fallback_turns_total[5m])) / clamp_min(sum(rate(grace_chat_turns_total[5m])), 1e-9)", "legendFormat": "fallback rate" }],
      "title": "Fallback rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
